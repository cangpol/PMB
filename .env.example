# ==============================================================================
# PMB Universitas Pignatelli Triputra - Kamus & Template Variabel Lingkungan (.env)
# Salin file ini menjadi .env untuk menjalankan sistem secara lokal atau via Docker.
# PERINGATAN: Jangan pernah mempublikasikan file .env yang berisi nilai produksi ke Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Aplikasi & Konfigurasi Server
# ------------------------------------------------------------------------------
APP_ENV=development                       # 'development', 'staging', atau 'production'
PORT=8080                                 # Port internal backend API
API_HOST=0.0.0.0                          # Alamat bind peladen API
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://pmb.upitra.ac.id

# ------------------------------------------------------------------------------
# 2. Keamanan, Enkripsi, & Pengaturan Sesi
# ------------------------------------------------------------------------------
# Kunci rahasia sesi (Wajib string acak minimal 32 karakter pada produksi)
SESSION_SECRET=kunci_rahasia_sesi_pmb_pignatelli_triputra_minimal_32_karakter_aman
COOKIE_SECURE=false                       # Set 'true' jika berjalan di balik HTTPS
COOKIE_SAME_SITE=Lax                      # Kebijakan SameSite cookie ('Lax', 'Strict', 'None')
COOKIE_MAX_AGE_SECS=86400                 # Durasi masa berlaku sesi dalam detik (24 jam)

# ------------------------------------------------------------------------------
# 3. Database PostgreSQL 16
# ------------------------------------------------------------------------------
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_DB=pmb_db
POSTGRES_USER=pmb_user
POSTGRES_PASSWORD=pmb_password
DATABASE_URL=postgres://pmb_user:pmb_password@localhost:5432/pmb_db
DATABASE_MAX_CONNECTIONS=20

# ------------------------------------------------------------------------------
# 4. Redis In-Memory Cache, Rate Limiting, & Sesi
# ------------------------------------------------------------------------------
# Format: redis://[:password@]host:port
REDIS_PASSWORD=pmb_redis_secret
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 5. Penyimpanan Berkas Objek (MinIO S3-Compatible)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pmb-berkas
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 6. Integrasi Midtrans Payment Gateway
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=midtrans         # 'midtrans' atau 'mock'
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXX    # Server Key dari Dashboard Midtrans (Sandbox/Prod)
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXX    # Client Key dari Dashboard Midtrans
MIDTRANS_IS_PRODUCTION=false              # Set 'true' untuk transaksi produksi riil
MOCK_PAYMENT_SECRET=mock_payment_dev_secret_key_2026

# ------------------------------------------------------------------------------
# 7. Pengaturan Kompilasi SQLx Offline
# ------------------------------------------------------------------------------
# Mengizinkan kompilasi Rust 'cargo build' membaca skema dari folder .sqlx tanpa koneksi DB langsung
SQLX_OFFLINE=true
