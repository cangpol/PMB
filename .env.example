# ==============================================================================
# PMB Universitas Pignatelli Triputra - Environment Variables Example
# Salin file ini menjadi .env untuk menjalankan sistem secara lokal atau via Docker
# ==============================================================================

# Aplikasi & Server
APP_ENV=development
PORT=8080
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Keamanan & Sesi
# Gunakan string acak minimal 32 karakter pada produksi
SESSION_SECRET=kunci_rahasia_sesi_pmb_pignatelli_triputra_minimal_32_karakter_aman
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_MAX_AGE_SECS=86400

# Database PostgreSQL
# Untuk Docker Compose: postgres://pmb_user:pmb_password@postgres:5432/pmb_db
# Untuk Lokal Windows: postgres://postgres:postgres@localhost:1234/pmb_db
DATABASE_URL=postgres://pmb_user:pmb_password@localhost:5432/pmb_db
DATABASE_MAX_CONNECTIONS=20

# Redis Cache & Session Store
# Untuk Docker Compose: redis://redis:6379
# Untuk Lokal: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# MinIO / Object Storage (S3-Compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pmb-berkas
S3_REGION=us-east-1

# Pengaturan SQLx Offline Mode (untuk build CI/CD tanpa koneksi DB langsung)
SQLX_OFFLINE=true

