# Git ignore for PMB Universitas Pignatelli Triputra Monorepo

# Environment variables
.env
.env.local
.env.*.local
*.env

# Rust
apps/api/target/
apps/api/**/target/
**/*.rs.bk
Cargo.lock.backup

# Node / Frontend
apps/web/node_modules/
apps/web/dist/
apps/web/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & storage data directories
docker-data/
postgres-data/
redis-data/
minio-data/

# Test Artifacts & Playwright
apps/web/test-results/
apps/web/playwright-report/
backups/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

